# UniDock settings. Copy this file to .env.local (local) or add the same names in
# Vercel → Project → Settings → Environment Variables (hosted).
# Only the three Supabase values are required. Everything else is optional: a
# feature whose settings are empty simply stays off.

# ── Required: Supabase (Supabase → Project Settings → API) ───────────────────
# Deployed with the Deploy button? Vercel's Supabase integration sets these for
# you, under its own names (SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_SECRET_KEY, POSTGRES_URL_NON_POOLING), which UniDock also reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never put this in a NEXT_PUBLIC_ variable or share it.
# Used to invite employees, run scheduled jobs and encrypt stored login details.
SUPABASE_SERVICE_ROLE_KEY=

# ── Database updates during each build (scripts/migrate.mjs) ─────────────────
# Supabase → Connect → Session pooler connection string, with your password.
# Not needed with the Vercel integration (it sets POSTGRES_URL_NON_POOLING).
SUPABASE_DB_URL=
# Set to true to stop the build from changing the database.
SKIP_DB_MIGRATIONS=
# Before each database update the build saves a snapshot of all data to the
# private Storage bucket "unidock-snapshots". Set to true to update without one.
SKIP_PRE_UPDATE_SNAPSHOT=

# ── Optional: update notice ───────────────────────────────────────────────────
# Admins see a notice when a newer UniDock release is out (only GitHub's public
# release list is read; nothing is sent). Set to off to turn it off.
UNIDOCK_UPDATE_CHECK=
# Releases to follow, as owner/name. Default: nabilsajid/UniDock.
UNIDOCK_UPDATE_REPO=

# ── Optional: scheduled daily job (vercel.json runs /api/cron/daily) ──────────
# When set, Vercel sends it with the daily job and every other caller is refused.
CRON_SECRET=

# ── Optional: company mailbox passwords ───────────────────────────────────────
# Key used to encrypt each company's saved mailbox password (Settings → Reminders).
# Falls back to SUPABASE_SERVICE_ROLE_KEY. If it changes, mailboxes must be saved again.
MAIL_SECRET=

# ── Optional: urgent alerts by email (Resend) ─────────────────────────────────
RESEND_API_KEY=
# An address on a domain verified in Resend.
ALERT_FROM_EMAIL=

# ── Optional: urgent alerts by WhatsApp (Meta WhatsApp Cloud API) ─────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of an approved message template, and its language code (default: en).
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=

# ── Optional: alerts on phones and computers (web push) ───────────────────────
# An admin can generate the key pair under My profile → Alerts on this device.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service, e.g. mailto:you@yourcompany.com
VAPID_SUBJECT=

# ── Optional: built-in logo files ─────────────────────────────────────────────
# Set to "first" to use public/logo.png and public/logo-dark.png (add them yourself)
# for the first company when it has not uploaded a logo. Leave empty to show the
# company name instead.
BUILT_IN_INVOICE_LOGO=

# ── Only for `npm run seed:demo` ──────────────────────────────────────────────
# Creates one company, its admin user and the demo employees in scripts/demo-team.json.
DEMO_ORG_NAME=Demo Studio
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
# Shared password for the demo employees. Leave empty to skip creating them.
DEMO_EMPLOYEE_PASSWORD=

# ── Only for `npm run test:db` ────────────────────────────────────────────────
# Postgres connection string of a throwaway database, never your live one.
DATABASE_URL=
